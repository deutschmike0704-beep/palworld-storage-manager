# Local Game Pass install (for deploy scripts)
# Xbox PC Game Pass / Microsoft Store — PRIMARY target for this project

PALWORLD_ROOT=
# Example (typical, may vary by machine / language):
# PALWORLD_ROOT=C:/XboxGames/Palworld/Content
# Or under WindowsApps / XboxGames depending on install

# Binary folder name — Game Pass uses WinGDK (NOT Steam Win64)
PALWORLD_BINARIES_DIR=WinGDK

# Full binaries path is usually:
#   ${PALWORLD_ROOT}/Pal/Binaries/${PALWORLD_BINARIES_DIR}
#
# UE4SS mod deploy target (one of these, depending on UE4SS layout):
#   .../WinGDK/ue4ss/Mods/PalStorageManager
#   .../WinGDK/Mods/PalStorageManager

# Optional: shipping exe name for process checks
# PALWORLD_EXE=Palworld-WinGDK-Shipping.exe
